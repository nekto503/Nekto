{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nekto",
  "version": "1.1.5",
  "identifier": "com.nekto.music",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nekto",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Nekto — локальный музыкальный плеер",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "longDescription": "Локальный музыкальный плеер Nekto для Windows",
    "copyright": "Copyright © Nekto",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "Nekto"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "Nekto",
        "description": "Открывать MP3-файлы в музыкальном плеере Nekto",
        "role": "Viewer"
      }
    ]
  }
}
